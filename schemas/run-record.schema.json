{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nobbettt/acta/schemas/run-record.schema.json",
  "title": "Acta run record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "id", "agent", "agent_version", "cwd", "run_dir", "command", "started_at", "completed_at", "duration_ms", "ok", "timeout", "termination_reason", "raw_stdout_path", "raw_stderr_path", "raw_stdout_artifact", "raw_stderr_artifact", "prompt_source", "otlp_status", "process_containment", "agent_config_mode"],
  "properties": {
    "schema_version": {"const": 2},
    "producer": {"$ref": "#/$defs/producer"},
    "id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string"},
    "agent": {"enum": ["codex", "claude"]},
    "agent_version": {"type": "string"},
    "cwd": {"type": "string", "minLength": 1},
    "base_commit_sha": {"type": "string"},
    "base_branch": {"type": "string"},
    "base_dirty": {"type": "boolean"},
    "head_commit_sha": {"type": "string"},
    "model": {"type": "string"},
    "repository": {"type": "string"},
    "issue_number": {"type": "integer", "minimum": 1},
    "issue_title": {"type": "string"},
    "issue_body": {"type": "string", "maxLength": 524288},
    "task_title": {"type": "string", "maxLength": 140},
    "run_dir": {"type": "string", "minLength": 1},
    "command": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "exit_code": {"type": "integer"},
    "ok": {"type": "boolean"},
    "timeout": {"type": "boolean"},
    "termination_reason": {"enum": ["completed", "timeout", "cancelled", "process_error", "resource_limit", "acta_error", "provider_error", "failed", "degraded", "error", "interrupted"]},
    "error": {"type": "string"},
    "raw_stdout_path": {"type": "string", "minLength": 1},
    "raw_stderr_path": {"type": "string", "minLength": 1},
    "raw_stdout_artifact": {"type": "string", "minLength": 1},
    "raw_stderr_artifact": {"type": "string", "minLength": 1},
    "prompt_source": {"enum": ["flag", "args", "stdin", "internal", "test"]},
    "prompt_captured": {"type": "boolean"},
    "otlp_status": {"enum": ["not_configured", "not_sampled", "exported", "failed"]},
    "otlp_error": {"type": "string"},
    "raw_output_limit_bytes": {"type": "integer", "minimum": 0},
    "raw_output_limit_exceeded": {"type": "boolean"},
    "workspace_diff_limit_bytes": {"type": "integer", "minimum": 0},
    "workspace_diff_limit_exceeded": {"type": "boolean"},
    "recovery_dir": {"type": "string", "minLength": 1},
    "process_containment": {"enum": ["posix_process_group", "windows_job", "direct_process"]},
    "agent_config_mode": {"enum": ["ambient_ephemeral", "project_only_ephemeral", "authoritative_bundle"]},
    "runtime_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reasoning_redaction_state": {"enum": ["retained_local", "redacted", "failed"]},
    "published_bundle": {"$ref": "#/$defs/published_bundle"}
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "acta"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string"},
        "date": {"type": "string"}
      }
    },
    "published_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
